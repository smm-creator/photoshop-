/**
 * Clothes Retouch — Import Open Documents as Raster Layers (UXP)
 * File: ImportAsRasterLayers.psjs
 *
 * Variant A:
 *  - Active document = master receiver
 *  - All OTHER currently open documents = sources (any type Photoshop opened:
 *    ARW, CR2, NEF, JPG, PNG, TIFF, PSD, PSB, etc.)
 *  - No file picker / no Explorer dialog
 *  - Transfer as ordinary pixel layers via duplicateLayers
 *  - Close sources without saving
 */

const photoshop = require("photoshop");
const { app, core, constants } = photoshop;

/** @typedef {"merged" | "topPixel"} ImportMode */

const CONFIG = {
  /** @type {ImportMode} */
  importMode: "merged",
  putIntoImportGroup: true,
  importGroupName: "IMPORT",
  stripExtensionFromLayerName: true,
  activateLastImportedLayer: true,
};

function stripExtension(name) {
  return String(name).replace(/\.[^.]+$/i, "");
}

function layerNameFromDoc(doc) {
  const base = doc.name || "imported";
  return CONFIG.stripExtensionFromLayerName ? stripExtension(base) : base;
}

function kindOf(layer) {
  return layer && layer.kind != null ? String(layer.kind) : "";
}

function isPixelLayer(layer) {
  const k = kindOf(layer).toLowerCase();
  return (
    layer &&
    (layer.kind === constants.LayerKind.NORMAL ||
      k === "normal" ||
      k === "pixel")
  );
}

function isSmartObject(layer) {
  const k = kindOf(layer).toLowerCase();
  return (
    layer &&
    (layer.kind === constants.LayerKind.SMARTOBJECT ||
      k === "smartobject" ||
      k === "smart_object")
  );
}

function isGroupLayer(layer) {
  const k = kindOf(layer).toLowerCase();
  return (
    layer &&
    (layer.kind === constants.LayerKind.GROUP || k === "group" || k === "layerset")
  );
}

async function ensureImportGroup(masterDoc) {
  for (let i = 0; i < masterDoc.layers.length; i++) {
    const l = masterDoc.layers[i];
    if (isGroupLayer(l) && l.name === CONFIG.importGroupName) {
      return l;
    }
  }
  return masterDoc.createLayerGroup({ name: CONFIG.importGroupName });
}

async function prepareSourcePixelLayer(sourceDoc, desiredName) {
  if (CONFIG.importMode === "merged") {
    if (sourceDoc.layers.length > 1 || sourceDoc.backgroundLayer) {
      await sourceDoc.mergeVisibleLayers();
    }
    const layer = sourceDoc.activeLayers[0] || sourceDoc.layers[0];
    if (!layer) {
      throw new Error(`No layer after merge in "${sourceDoc.name}"`);
    }
    if (isSmartObject(layer)) {
      await layer.rasterize();
    }
    if (!isPixelLayer(layer) && typeof layer.rasterize === "function") {
      await layer.rasterize();
    }
    layer.name = desiredName;
    return layer;
  }

  let layer = sourceDoc.activeLayers[0] || sourceDoc.layers[0];
  if (!layer) {
    throw new Error(`No layers in "${sourceDoc.name}"`);
  }
  if (isGroupLayer(layer)) {
    const kids = layer.layers || [];
    layer = kids[0] || layer;
  }
  if (isSmartObject(layer)) {
    await layer.rasterize();
  }
  if (!isPixelLayer(layer) && typeof layer.rasterize === "function") {
    await layer.rasterize();
  }
  layer.name = desiredName;
  return layer;
}

async function assertRasterLayer(layer) {
  if (!layer) return null;
  if (isSmartObject(layer)) {
    await layer.rasterize();
  }
  if (!isPixelLayer(layer) && typeof layer.rasterize === "function") {
    await layer.rasterize();
  }
  return layer;
}

function collectSourceDocuments(masterDoc) {
  const sources = [];
  for (let i = 0; i < app.documents.length; i++) {
    const doc = app.documents[i];
    if (doc.id !== masterDoc.id) {
      sources.push(doc);
    }
  }
  return sources;
}

async function importOneOpenDocument(sourceDoc, masterDoc, importGroup) {
  const desiredName = layerNameFromDoc(sourceDoc);
  const sourceId = sourceDoc.id;

  try {
    app.activeDocument = sourceDoc;
    const sourceLayer = await prepareSourcePixelLayer(sourceDoc, desiredName);
    const copies = await sourceDoc.duplicateLayers([sourceLayer], masterDoc);
    let imported = copies && copies[0];
    imported = await assertRasterLayer(imported);

    if (imported) {
      imported.name = desiredName;
      if (CONFIG.putIntoImportGroup && importGroup) {
        await imported.move(importGroup, constants.ElementPlacement.PLACEINSIDE);
      }
    }

    return imported;
  } finally {
    // Close source by id if still open
    try {
      let still = null;
      for (let i = 0; i < app.documents.length; i++) {
        if (app.documents[i].id === sourceId) {
          still = app.documents[i];
          break;
        }
      }
      if (still) {
        still.closeWithoutSaving();
      }
    } catch (_) {
      /* ignore */
    }
  }
}

async function runImport(executionContext) {
  const masterDoc = app.activeDocument;
  if (!masterDoc) {
    await app.showAlert("Open the master PSD first, then open other photos as tabs.");
    return;
  }

  if (app.documents.length < 2) {
    await app.showAlert(
      "Need at least 2 open documents.\n\n" +
        "1) Open master PSD (keep it active)\n" +
        "2) Open other photos as tabs (ARW, JPG, PSD, ...)\n" +
        "3) Click back on the master PSD\n" +
        "4) Run this script again"
    );
    return;
  }

  const masterId = masterDoc.id;
  const sources = collectSourceDocuments(masterDoc);
  if (!sources.length) {
    await app.showAlert("No other open documents to import.");
    return;
  }

  const importGroup = CONFIG.putIntoImportGroup
    ? await ensureImportGroup(masterDoc)
    : null;

  const errors = [];
  let lastImported = null;
  let okCount = 0;

  if (executionContext && executionContext.reportProgress) {
    executionContext.reportProgress({ value: 0, commandName: "Import open documents" });
  }

  for (let i = 0; i < sources.length; i++) {
    const src = sources[i];
    const srcName = src.name;
    if (executionContext && executionContext.reportProgress) {
      executionContext.reportProgress({
        value: i / sources.length,
        commandName: `Import ${srcName} (${i + 1}/${sources.length})`,
      });
    }
    try {
      app.activeDocument = masterDoc;
      lastImported = await importOneOpenDocument(src, masterDoc, importGroup);
      okCount += 1;
    } catch (err) {
      errors.push(`${srcName}: ${err && err.message ? err.message : String(err)}`);
      try {
        const active = app.activeDocument;
        if (active && active.id !== masterId) {
          active.closeWithoutSaving();
        }
      } catch (_) {
        /* ignore */
      }
    }
  }

  let stillOpen = null;
  for (let i = 0; i < app.documents.length; i++) {
    if (app.documents[i].id === masterId) {
      stillOpen = app.documents[i];
      break;
    }
  }
  if (stillOpen) {
    app.activeDocument = stillOpen;
    if (CONFIG.activateLastImportedLayer && lastImported) {
      stillOpen.activeLayers = [lastImported];
    }
  }

  if (executionContext && executionContext.reportProgress) {
    executionContext.reportProgress({ value: 1, commandName: "Import done" });
  }

  const summary = `Imported ${okCount}/${sources.length} open document(s) as raster layers into "${masterDoc.name}".`;
  if (errors.length) {
    await app.showAlert(
      `${summary}\n\nErrors (${errors.length}):\n` + errors.slice(0, 8).join("\n")
    );
  } else {
    await app.showAlert(summary);
  }
}

async function main() {
  try {
    await core.executeAsModal(runImport, {
      commandName: "Import Open Docs as Raster Layers",
    });
  } catch (err) {
    const msg = err && err.message ? err.message : String(err);
    if (/modal/i.test(msg)) {
      await runImport(null);
    } else {
      await app.showAlert(`Import failed: ${msg}`);
      throw err;
    }
  }
}

main();
